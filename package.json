{
  "name": "d17",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api",
    "contracts"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": "12.2.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.23"
    },
    "postcss": "8.5.32",
    "hardhat": "3.18.1",
    "undici": "7.30.1",
    "solc": {
      "tmp": "0.2.7"
    },
    "baseline-browser-mapping": "2.11.34"
  },
  "devDependencies": {
    "@uniswap/v2-core": "1.0.1",
    "postcss": "8.5.32",
    "solc": "0.8.38"
  },
  "scripts": {
    "dev": "npm run dev:rpc",
    "dev:rpc": "npm run dev:rpc -w @d17/web",
    "dev:api": "node scripts/run-local-stack.mjs",
    "web:rpc": "npm run dev:rpc -w @d17/web",
    "web:api": "npm run dev:api -w @d17/web",
    "api:sepolia": "npm run start:sepolia -w @d17/api",
    "api:mainnet": "npm run start:mainnet -w @d17/api",
    "api:all": "npm run start:all -w @d17/api",
    "build": "npm run build -w @d17/web",
    "typecheck": "npm run typecheck -w @d17/web",
    "test:api": "npm test -w @d17/api",
    "test:contracts": "npm test -w @d17/contracts",
    "demo:local": "npm run demo:local -w @d17/contracts --",
    "demo:fund": "npm run demo:fund -w @d17/contracts --",
    "release:checksums": "node scripts/generate-candidate-checksums.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "content:sync": "node scripts/sync-site-content.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify": "npm run typecheck && npm run test:api && npm run test:contracts && npm run test:guard && npm run test:activity-dedupe && npm run test:activity-history && npm run check:release && npm run test:read-provider && npm run test:wallet-target",
    "test": "npm run typecheck && npm run test:api && npm run test:contracts && npm run test:guard && npm run test:activity-dedupe && npm run test:activity-history && npm run test:read-provider && npm run test:wallet-target",
    "test:guard": "npm run test:guard -w @d17/web",
    "test:activity-dedupe": "npm run test:activity-dedupe -w @d17/web",
    "test:activity-history": "npm run test:activity-history -w @d17/web",
    "release:candidate": "node scripts/export-candidate.mjs",
    "check:candidate": "node scripts/export-candidate.mjs --check && node scripts/check-candidate-surfaces.mjs && node scripts/check-doc-links.mjs",
    "test:deployment-gas": "node apps/web/scripts/test-deployment-gas.mjs",
    "verify:candidate-build": "node scripts/verify-candidate-solc.mjs",
    "check:release:legacy": "node scripts/check-release-legacy.mjs && node scripts/check-doc-links.mjs",
    "release:checksums:legacy": "node scripts/generate-release-checksums.mjs",
    "release:protocol:legacy": "node scripts/generate-protocol-release.mjs",
    "test:release-integrity": "node --test scripts/test-release-integrity.mjs scripts/test-release-build-id.mjs scripts/test-publication-cli.mjs",
    "check:dependency-tree": "node scripts/check-dependency-tree.mjs",
    "test:launch-state": "npm run test:launch-state -w @d17/web",
    "test:read-provider": "node apps/web/scripts/test-read-provider.mjs",
    "test:wallet-target": "npm run test:wallet-target -w @d17/contracts",
    "test:release-plan": "npm run test:release-plan -w @d17/contracts",
    "test:production-http": "node scripts/test-production-http.mjs",
    "test:browser": "npm run compile -w @d17/contracts && npm run test:browser -w @d17/contracts"
  },
  "packageManager": "npm@12.2.1"
}
